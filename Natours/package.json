  "description": "learning node, express and mongoDB",
  "main": "app.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "start": "nodemon server.js",
    "start:pro": "SET NODE_ENV=production && nodemon server.js",
    "debug": "ndb server.js",
    "watch:js": "esbuild ./public/js/index.js --bundle --outdir=./public/js/bundled --watch",

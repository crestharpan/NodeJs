extends base

block append head
  style.
    .product-container {
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background-color: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
      max-width: 900px;
      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: auto;
      max-width: 400px;
      object-fit: cover;
    }

    .product-details {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding-left: 30px;
      padding-right: 30px;
      flex: 1;
    }

    .product-title {
      font-size: 28px;
    }

    .product-description {
      font-size: 16px;
      color: #555;
    }

    .product-price {
      font-size: 24px;
      color: #4caf50;
      font-weight: bold;
    }

    .product-reviews {
      font-size: 15px;
      color: #777;
    }

    .small-element {
      display: flex;
      align-self: center;
    }

    form {
      display: flex;
      align-self: stretch;
      flex-direction: column;
    }

    .add-to-cart-btn,
    .book-btn {
      padding: 12px 24px;
      background-color: #4caf50;
      margin-left: 5px;
      margin-right: 5px;
      color: white;
      border: none;
      font-size: 16px;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .add-to-cart-btn:hover {
      background-color: #388e3c;
    }
    .book-btn:hover {
      background-color: #388e3c;
    }

block content
  .product-container
    .product-image
      img(src=image, alt='Product Image')
    .product-details
      h1.product-title= title
      p.product-description Breathtaking view to refresh your whole body.
      .product-price= '$' + price
      .product-reviews= averageRating
    button.add-to-cart-btn Add to Cart
    p.small-element or simply
    form(
      action='https://rc-epay.esewa.com.np/api/epay/main/v2/form',
      method='POST'
    )
      input#amount(type='hidden', name='amount', value=price, required='')
      input#tax_amount(
        type='hidden',
        name='tax_amount',
        value='0',
        required=''
      )
      input#total_amount(
        type='hidden',
        name='total_amount',
        value=price,
        required=''
      )
      input#transaction_uuid(
        type='hidden',
        name='transaction_uuid',
        value=uid,
        required=''
      )
      input#product_code(
        type='hidden',
        name='product_code',
        value='EPAYTEST',
        required=''
      )
      input#product_service_charge(
        type='hidden',
        name='product_service_charge',
        value='0',
        required=''
      )
      input#product_delivery_charge(
        type='hidden',
        name='product_delivery_charge',
        value='0',
        required=''
      )
      input#success_url(
        type='hidden',
        name='success_url',
        value='https://developer.esewa.com.np/success',
        required=''
      )
      input#failure_url(
        type='hidden',
        name='failure_url',
        value='https://developer.esewa.com.np/failure',
        required=''
      )
      input#signed_field_names(
        type='hidden',
        name='signed_field_names',
        value='total_amount,transaction_uuid,product_code',
        required=''
      )
      input#signature(
        type='hidden',
        name='signature',
        value=signature,
        required=''
      )
      button.book-btn(type='submit') Book

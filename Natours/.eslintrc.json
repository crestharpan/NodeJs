{
  "extends": [
    "airbnb",
    "prettier",
    "plugin:node/recommended",
    "eslint:recommended" // Add this to include the recommended ESLint rules
  ],
  "plugins": ["prettier"],
  "parserOptions": {
    "ecmaVersion": "latest", // Support latest ECMAScript features
    "sourceType": "module" // Use 'module' type for import/export
  },
  "env": {
    "browser": true, // Allow browser globals
    "es2021": true, // Support ECMAScript 2021 features
    "node": true // Recognize Node.js globals like process, require, etc.
  },
  "rules": {
    "prettier/prettier": ["error", { "endOfLine": "auto" }],
    "spaced-comment": "off",
    "no-console": "off",
    "consistent-return": "off",
    "func-names": "off",
    "object-shorthand": "off",
    "no-process-exit": "off",
    "no-param-reassign": "off",
    "no-return-await": "off",
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "prefer-destructuring": ["error", { "object": true, "array": false }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "req|res|next|val" }]
  }
}
